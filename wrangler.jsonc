{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sumitos-api",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",

  // Plain variable, not a secret — it is the public origin the portfolio is served from and is
  // used for CORS and for resolving the packaged resume URL.
  // The one real secret, ADMIN_PASSWORD_HASH, is set with `wrangler secret put` and never lives
  // in this file.
  "vars": {
    "SITE_ORIGIN": "https://sumitjadhav.vercel.app"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sumitos",
      // Replace after `wrangler d1 create sumitos` — the command prints it.
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "sumitos-assets"
    }
  ],

  // Ask Sumit's Python Worker (ai/). It has no route of its own — this binding is the only way
  // to reach it, so the origin check and the rate limit below cannot be walked around.
  // Deploy `ai/` first: a service binding to a Worker that does not exist yet fails to deploy.
  "services": [
    {
      "binding": "ASK_AI",
      "service": "sumitos-ai"
    }
  ],

  // 20 questions per IP per minute on /api/ask. Cloudflare's own limiter rather than a row
  // count in D1: the assistant costs real inference, and worker/auth.ts already notes this
  // binding as the upgrade path from its login counter.
  "unsafe": {
    "bindings": [
      {
        "name": "ASK_LIMIT",
        "type": "ratelimit",
        "namespace_id": "2001",
        "simple": { "limit": 20, "period": 60 }
      }
    ]
  },

  // The admin SPA. `run_worker_first` keeps the API paths out of the static-asset handler;
  // everything else falls through to the built files, with SPA routing for /admin/*.
  "assets": {
    "binding": "ASSETS",
    "directory": "worker/assets",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/", "/api/*", "/admin/api/*", "/files/*", "/icons/*"]
  },

  "observability": { "enabled": true }
}
